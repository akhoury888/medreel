# --- required ---
DOMAIN=app.yourdomain.com
PUBLIC_URL=https://app.yourdomain.com
SECRET_KEY=change-me-to-a-long-random-string        # python -c "import secrets;print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=change-me-too

# --- Stripe (dashboard.stripe.com) ---
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...                     # webhook endpoint: https://app.yourdomain.com/stripe/webhook
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_CLINIC=price_...
STRIPE_AUTOMATIC_TAX=0                              # 1 = let Stripe Tax collect GST/HST/QST etc.
PRICE_CURRENCY=USD

# --- AI scripts, transcript clean-up and subtitle translation (console.anthropic.com) ---
ANTHROPIC_API_KEY=
# Optional: ElevenLabs Scribe for Arabic/French transcription (much better on Lebanese dialect; ~$0.22 per hour of audio)
ELEVENLABS_API_KEY=
# Optional: free stock videos from Pexels (pexels.com/api) — auto B-roll + search in the studio
PEXELS_API_KEY=
# ...or Pixabay (free key at pixabay.com/api/docs) — used when no Pexels key is set
PIXABAY_API_KEY=
# Optional: AI medical illustrations with FLUX.2 on fal.ai (~$0.03 per image). Briefs are written by Claude (ANTHROPIC_API_KEY).
FAL_KEY=
MEDREEL_LLM=claude-sonnet-5-5

# --- email for password resets (any SMTP provider: Postmark, SendGrid, Gmail Workspace...) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=MedReel <no-reply@yourdomain.com>

# --- limits & models ---
MAX_UPLOAD_MB=1500
MAX_VIDEO_SECONDS=600
WITH_LARGE=0          # 1 = include Whisper large-v3 (best Lebanese-Arabic accuracy; slow without a GPU)
MEDREEL_WHISPER_AR=large-v3
MEDREEL_DEV=0         # 1 = local testing: fake checkout, reset links on screen. Never in production.
